# ---- API keys (all free signup) ----
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Jamendo: free instrumental music API. Signup: https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=

# ---- Optional LLM ----
# Groq free tier (recommended). Signup: console.groq.com -> API key.
GROQ_API_KEY=

# Generic OpenAI-compatible (alternative). Leave blank if using Groq/Ollama.
